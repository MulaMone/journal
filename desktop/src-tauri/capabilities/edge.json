{
  "identifier": "edge-window-controls",
  "description": "Lets the EDGE site drive the custom title bar buttons",
  "windows": [
    "main",
    "child-*"
  ],
  "remote": {
    "urls": [
      "https://mulamone.github.io/*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized"
  ]
}
