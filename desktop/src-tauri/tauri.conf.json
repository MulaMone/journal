{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDGE",
  "version": "1.0.5",
  "identifier": "com.mulamone.edge",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EDGE \u2014 Trading Terminal",
        "create": false,
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
